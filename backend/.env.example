# Copier ce fichier en ".env" (jamais committe, deja dans .gitignore) et remplir
# les vraies valeurs avant de lancer "docker compose up".

DB_NAME=loup
DB_USERNAME=postgres
DB_PASSWORD=change_me_mot_de_passe_fort

# Generer avec : openssl rand -base64 32
JWT_SECRET=change_me_avec_openssl_rand_base64_32
# Token d'acces (JWT) : duree courte, en millisecondes. 900000 = 15 min.
JWT_EXPIRATION_MS=900000
# Refresh token : duree longue, en jours. Porte la "session" sur mobile.
JWT_REFRESH_EXPIRATION_DAYS=30

# Origines autorisees en CORS, separees par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:4200,capacitor://localhost,http://localhost,https://localhost

# "update" conserve les donnees entre redemarrages. "create" repart de zero a chaque fois (dev uniquement).
DDL_AUTO=update
